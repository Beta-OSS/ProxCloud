# --- Database ---------------------------------------------------------------
# Used when running the app directly. Under docker compose the host is replaced by "db"
# and the POSTGRES_* values below are used. Use a URL-safe password (no @ : / ? # characters).
DATABASE_URL=postgresql+psycopg://portal:change_this_password@localhost:5432/portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=portal

# --- Secrets (required; the app refuses to start without valid values) ------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# --- Behaviour ---------------------------------------------------------------
# Keep true behind HTTPS. Set to false ONLY for plain-HTTP local development.
COOKIE_SECURE=true
TOTP_ISSUER=ProxCloud Private Portal
ENABLE_API_DOCS=false

# IPs of your reverse proxy allowed to set X-Forwarded-For (used for rate limiting).
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional tuning (defaults shown)
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# LOGIN_MAX_FAILURES_PER_USER=10
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
